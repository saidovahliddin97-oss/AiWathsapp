# =====================================================================
#  Family Assistant — настройки. Скопируйте в .env (start.command делает это сам)
#  НИКОГДА не публикуйте .env — там ваши ключи.
# =====================================================================

# --- Модель (нужен ОДИН ключ) -----------------------------------------
# Бесплатно и работает из России: ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# auto = бот сам выбирает лучшие бесплатные модели (Gemma, Qwen, ...)
OPENROUTER_MODEL=auto
# Бесплатно, но НЕ работает из России: ключ Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Платно, но таджикский лучше: ключ Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# auto = Claude если есть ключ, иначе Gemini, иначе демо-шаблоны
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Серверный fallback Claude при отказе (beta); false, если аккаунт не поддерживает
LLM_USE_FALLBACKS=true

# --- WhatsApp -----------------------------------------------------------
# bridge = бесплатно, через «Связанные устройства» (QR-код)
# cloud  = официальный WhatsApp Cloud API (нужны WHATSAPP_* ниже)
WHATSAPP_MODE=bridge
# true  = бот работает на ВАШЕМ личном WhatsApp
# false = бот на отдельном номере (вторая SIM)
PERSONAL_NUMBER=false
# Ваш личный номер (без +): сюда бот шлёт уведомления и отсюда принимает команды.
# В режиме PERSONAL_NUMBER=true можно оставить пустым — всё идёт в чат «Вы (Избранное)».
OWNER_PHONE=
# Как вас зовут/называют — в общей группе бот отвечает, только если обращаются к нему
OWNER_NAMES=
# Секрет между ботом и мостом; start.command заполнит сам
BRIDGE_TOKEN=
BRIDGE_URL=http://127.0.0.1:3001
BRIDGE_MAX_PER_HOUR=30

# --- Поведение -----------------------------------------------------------
NOTIFY_OWNER=true
FORWARD_UNANSWERED=true
# Если вы сами ответили человеку, бот молчит в этом чате N минут
MANUAL_PAUSE_MINUTES=120
# Приветствия по расписанию: тем, с кем не было переписки N дней
GREETINGS_ENABLED=true
GREETING_INTERVAL_DAYS=7
GREETING_HOURS=10-20
GREETING_GAP_MINUTES_MIN=1
GREETING_GAP_MINUTES_MAX=5

DATABASE_PATH=database/assistant.db
RELATIVES_FILE=config/relatives.json
HISTORY_LIMIT=24
IGNORE_UNKNOWN_SENDERS=true
# true = ничего не отправляется в WhatsApp (проверка)
DRY_RUN=false
ALLOW_OFFLINE_GENERATOR=true
LOG_MESSAGE_TEXT=false
ADMIN_TOKEN=

# --- Только для WHATSAPP_MODE=cloud ---------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
