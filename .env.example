# --- Claude API ---
# (LLM_* names avoid clashing with Claude Code's own CLAUDE_* / ANTHROPIC_MODEL variables)
# Get a key at https://console.anthropic.com  (NEVER commit the real value)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Server-side refusal fallback (beta). Set to false if your account doesn't support it.
LLM_USE_FALLBACKS=true

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret for X-Hub-Signature-256 verification (optional but recommended)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Behaviour ---
DATABASE_PATH=database/assistant.db
RELATIVES_FILE=config/relatives.json
HISTORY_LIMIT=24
# Only answer relatives listed in RELATIVES_FILE (unknown numbers are ignored)
IGNORE_UNKNOWN_SENDERS=true
# If true, no real WhatsApp messages are sent (they are only logged + stored)
DRY_RUN=false
# If true and ANTHROPIC_API_KEY is empty, an offline template generator is used (demo only)
ALLOW_OFFLINE_GENERATOR=true
# Log message texts (disable in production for privacy)
LOG_MESSAGE_TEXT=false
# Protects /admin and /demo endpoints (empty = disabled in production)
ADMIN_TOKEN=
